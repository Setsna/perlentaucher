        && saStempelOk(d.stempel, 'finden:mittel')
        && saStempelOk(d.stempel, 'finden:knifflig')
        && saStempelOk(d.stempel, 'bestimmungen:leicht')
        && saStempelOk(d.stempel, 'bestimmungen:mittel')
        && saStempelOk(d.stempel, 'bestimmungen:knifflig')
        && saStempelOk(d.stempel, 'ergaenzungen:leicht')
        && saStempelOk(d.stempel, 'ergaenzungen:mittel')
        && saStempelOk(d.stempel, 'ergaenzungen:knifflig')
        && saStempelOk(d.stempel, 'erweitern:leicht')
        && saStempelOk(d.stempel, 'erweitern:mittel')
        && saStempelOk(d.stempel, 'erweitern:knifflig')
        && saStempelOk(d.stempel, 'stimmt:leicht')
        && saStempelOk(d.stempel, 'stimmt:mittel')
        && saStempelOk(d.stempel, 'stimmt:knifflig')
        && saRundenOk(d.runden, 'umstellen:leicht')
        && saRundenOk(d.runden, 'umstellen:mittel')
        && saRundenOk(d.runden, 'umstellen:knifflig')
        && saRundenOk(d.runden, 'trennen:leicht')
        && saRundenOk(d.runden, 'trennen:mittel')
        && saRundenOk(d.runden, 'trennen:knifflig')
        && saRundenOk(d.runden, 'finden:leicht')
        && saRundenOk(d.runden, 'finden:mittel')
        && saRundenOk(d.runden, 'finden:knifflig')
        && saRundenOk(d.runden, 'bestimmungen:leicht')
        && saRundenOk(d.runden, 'bestimmungen:mittel')
        && saRundenOk(d.runden, 'bestimmungen:knifflig')
        && saRundenOk(d.runden, 'ergaenzungen:leicht')
        && saRundenOk(d.runden, 'ergaenzungen:mittel')
        && saRundenOk(d.runden, 'ergaenzungen:knifflig')
        && saRundenOk(d.runden, 'erweitern:leicht')
        && saRundenOk(d.runden, 'erweitern:mittel')
        && saRundenOk(d.runden, 'erweitern:knifflig')
        && saRundenOk(d.runden, 'stimmt:leicht')
        && saRundenOk(d.runden, 'stimmt:mittel')
        && saRundenOk(d.runden, 'stimmt:knifflig');
    }

    match /sa_stand/{code} {
      // get = das eigene Dokument gezielt holen.
      // list = alle durchblaettern (nur Lehrkraft, fuer Sicherung und Auskunft).
      allow get:    if istLehrer() || (istKind(code) && freigeschaltet(code));
      allow list:   if istLehrer();

      // Das Kind schreibt nur seinen eigenen Stand und nur in der
      // erlaubten Form. Die Lehrkraft darf schreiben, damit sie eine
      // Sicherung wieder einlesen kann.
      allow create, update: if istLehrer()
                            || (istKind(code) && freigeschaltet(code)
                                && saStandGueltig(request.resource.data));

      allow delete: if istLehrer();
    }

    // ---------- Abyss of Numbers: Stand eines Kindes ----------
    // Ein Dokument je Kind: an_stand/<code>. Kein Vorname.
    // spielstand = der ganze Spielstand des Spiels als Text (JSON), hoechstens
    // 20 000 Zeichen (heute hoechstens etwa 1 500). Den Inhalt prueft das Spiel
    // beim Laden. Neue Felder IM Spielstand brauchen keine Regelaenderung,
    // ein neues Feld NEBEN spielstand schon.

    function anStandGueltig(d) {
      return d.keys().hasOnly(['angelegt', 'geaendert', 'spielstand'])
        && d.keys().hasAll(['angelegt', 'geaendert', 'spielstand'])
        && d.geaendert is number && d.geaendert >= 0
        && d.angelegt is number
        && d.spielstand is string && d.spielstand.size() <= 20000;
    }

    match /an_stand/{code} {
      // get = das eigene Dokument gezielt holen.
      // list = alle durchblaettern (nur Lehrkraft, fuer Sicherung und Auskunft).
      allow get:    if istLehrer() || (istKind(code) && freigeschaltet(code));
      allow list:   if istLehrer();

      // Das Kind schreibt nur seinen eigenen Stand und nur in der
      // erlaubten Form. Die Lehrkraft darf schreiben, damit sie eine
      // Sicherung wieder einlesen kann.
      allow create, update: if istLehrer()
                            || (istKind(code) && freigeschaltet(code)
                                && anStandGueltig(request.resource.data));

      allow delete: if istLehrer();
    }

    // ---------- Oeffentlich: Freigabe der Lernplattformen ----------
    // Ein einziges Dokument: oeffentlich/plattformen. Je Plattform true
    // (offen) oder false (gesperrt), dazu geaendert. Keine Kinderdaten,
    // keine Namen, keine Codes. Lesen darf jeder, auch ohne Anmeldung
    // (die Lernlagune fragt es ab). Schreiben nur die Lehrkraft.
    // Neue Plattform: Schluessel hier dazu (wie in PLATTFORMEN, js/lehrer.js).

    function freigabeSchluessel() {
      return ['zahlenschwarm', 'flaschenpost', 'riffakten', 'seesternwerkstatt',
              'korallenriff', 'chancenbucht', 'leuchtturmuhr', 'kieselwaage',
              'walgesang', 'zeitenstrom', 'satzwerft', 'abyss'];
    }
    function freigabeWertOk(d, k) {
      return !(k in d) || d[k] is bool;
    }
    function freigabeGueltig(d) {
      return d.keys().hasOnly(freigabeSchluessel().concat(['geaendert']))
        && d.keys().hasAll(['geaendert'])
        && d.geaendert is number && d.geaendert >= 0
        && freigabeWertOk(d, 'zahlenschwarm') && freigabeWertOk(d, 'flaschenpost')
        && freigabeWertOk(d, 'riffakten') && freigabeWertOk(d, 'seesternwerkstatt')
        && freigabeWertOk(d, 'korallenriff') && freigabeWertOk(d, 'chancenbucht')
        && freigabeWertOk(d, 'leuchtturmuhr') && freigabeWertOk(d, 'kieselwaage')
        && freigabeWertOk(d, 'walgesang') && freigabeWertOk(d, 'zeitenstrom')
        && freigabeWertOk(d, 'satzwerft') && freigabeWertOk(d, 'abyss');
    }

    match /oeffentlich/{id} {
      allow get:    if id == 'plattformen' || istLehrer();
      allow list:   if istLehrer();
      allow create, update: if istLehrer() && id == 'plattformen'
                            && freigabeGueltig(request.resource.data);
      allow delete: if false;
    }

    // ---------- Alles Uebrige ist gesperrt ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
