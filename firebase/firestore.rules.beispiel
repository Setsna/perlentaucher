rules_version = '2';

// ============================================================
//  WortAbenteuer – Zugriffsregeln für Firestore
//  Projekt: lernplattform-44aa1
//
//  Grundsatz: Alles ist verboten, ausser es steht hier ausdruecklich.
//  Ein Kind kommt nur an seinen eigenen Spielstand. Die Lehrkraft
//  kommt an alles. Niemand kann die Kinderliste durchblaettern.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Wer ist wer? ----------

    // Lehrkraft: meldet sich mit diesem Google-Konto an.
    // WICHTIG: Hier muessen genau die Adressen stehen, mit denen du
    // dich bei Google anmeldest. Mehrere eigene Konten sind moeglich;
    // lower() faengt ab, dass Google die Adresse anders schreibt.
    function istLehrer() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'DEINE-EMAIL@example.com',
             'ZWEITE-EMAIL@example.com'
           ];
    }

    // Kind: meldet sich unsichtbar mit <code>@lernplattform-44aa1.firebaseapp.com an.
    // Der Code steht auf dem Aufkleber im Hausaufgabenheft.
    function istKind(code) {
      return request.auth != null
        && request.auth.token.email == code + '@lernplattform-44aa1.firebaseapp.com';
    }

    // Nur Codes, die du vorher angelegt hast, zaehlen als freigeschaltet.
    function freigeschaltet(code) {
      return exists(/databases/$(database)/documents/kinder/$(code));
    }

    // Der Code steckt im vorderen Teil der Anmelde-Adresse, immer klein
    // geschrieben (js/cloud.js: mailVon) - genau so heisst auch das
    // Dokument in "kinder".
    function mailCode() {
      return request.auth.token.email.split('@')[0];
    }

    // Ein Kind, dessen Code du angelegt hast.
    //
    // WICHTIG: "request.auth != null" allein ist KEINE Schranke. Jeder
    // Fremde kann sich mit dem oeffentlichen API-Schluessel selbst ein
    // Konto anlegen und ist dann angemeldet. Erst der Blick in "kinder"
    // macht daraus eine echte Pruefung. Deshalb steht unten ueberall
    // istKlassenmitglied() statt request.auth != null.
    function istKlassenmitglied() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[a-z0-9]+@lernplattform-44aa1[.]firebaseapp[.]com$')
        && freigeschaltet(mailCode());
    }

    // ---------- Kinderliste: Vorname und Code ----------
    // get   = ein einzelnes Kind gezielt nachschlagen
    // list  = die ganze Liste durchblaettern (nur Lehrkraft)
    match /kinder/{code} {
      allow get:   if istLehrer() || istKind(code);
      allow list:  if istLehrer();
      allow write: if istLehrer();
    }

    // ---------- Spielstand eines Kindes ----------
    // Perlen, Luftblasen, Wortstatistik, Abzeichen.
    // Kein Kind kann den Spielstand eines anderen Kindes lesen.
    match /fortschritt/{code} {
      allow read:   if istLehrer() || istKind(code);

      // Die Lehrkraft darf zuruecksetzen. Das Kind darf nur seinen
      // eigenen Stand schreiben, und nur mit plausiblen Werten.
      allow write:  if istLehrer()
                    || (istKind(code) && freigeschaltet(code)
                        && request.resource.data.xp is int
                        && request.resource.data.xp >= 0
                        && request.resource.data.xp <= 200000
                        // Was der Lehrerbereich anzeigt, muss den
                        // richtigen Typ haben. Sonst koennte ein
                        // Kinderkonto dort Text einschleusen.
                        && request.resource.data.get('lessons', 0) is number
                        && (request.resource.data.get('lastDay', null) == null
                            || (request.resource.data.lastDay is string
                                && request.resource.data.lastDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
                        && request.resource.data.get('days', {}) is map
                        && request.resource.data.get('words', {}) is map);
      allow delete: if istLehrer();
    }

    // ---------- Gemalte Bilder ----------
    // Ein Dokument je Bild, damit der Spielstand klein bleibt.
    // Die Kennung lautet <code>_<nummer>, im Feld "code" steht noch
    // einmal der Code des Kindes. Danach wird gesucht und geprueft.
    // Ein Kind kommt nur an seine eigenen Bilder.
    match /bilder/{id} {
      allow read:   if istLehrer() || istKind(resource.data.code);

      // Die Kennung muss <code>_<nummer> sein (js/cloud.js: bilderSichern),
      // hoechstens vierstellig. Sonst koennte ein Kinderkonto beliebig
      // viele Dokumente anlegen. Erlaubt sind nur die Felder, die die
      // App schreibt.
      allow create: if istLehrer()
                    || (istKind(request.resource.data.code)
                        && freigeschaltet(request.resource.data.code)
                        && request.resource.data.code is string
                        && id.matches('^' + request.resource.data.code + '_[0-9]{1,4}$')
                        && request.resource.data.keys().hasOnly(
                             ['code', 'id', 'art', 'g', 'px', 'striche', 'fertig', 'ts', 'geloescht'])
                        && (!('striche' in request.resource.data)
                            || request.resource.data.striche.size() <= 20000)
                        && (!('px' in request.resource.data)
                            || request.resource.data.px.size() <= 4096));

      allow update: if istLehrer()
                    || (istKind(resource.data.code)
                        && request.resource.data.code == resource.data.code
                        && request.resource.data.keys().hasOnly(
                             ['code', 'id', 'art', 'g', 'px', 'striche', 'fertig', 'ts', 'geloescht'])
                        && (!('striche' in request.resource.data)
                            || request.resource.data.striche.size() <= 20000)
                        && (!('px' in request.resource.data)
                            || request.resource.data.px.size() <= 4096));

      allow delete: if istLehrer() || istKind(resource.data.code);
    }

    // ---------- Gemeinsames Klassenziel ----------
    // Ein Dokument je Kalenderwoche, z. B. "2026-W38", mit einem Feld "perlen".
    // Jedes Kind darf diese Summe nur erhoehen und nur um einen
    // plausiblen Betrag. Es gibt hier keine Namen und keine Einzelwerte.
    match /klassenwochen/{woche} {
      allow read: if istLehrer() || istKlassenmitglied();

      // Die Kennung muss aussehen wie "2026-W38" (js/cloud.js:
      // wochenSchluessel). Sonst koennte jemand die Sammlung mit
      // beliebigen Dokumenten vollschreiben.
      allow create: if istKlassenmitglied()
        && woche.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['perlen'])
        && request.resource.data.perlen is int
        && request.resource.data.perlen >= 0
        && request.resource.data.perlen <= 500;

      allow update: if istKlassenmitglied()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perlen'])
        && request.resource.data.perlen is int
        && request.resource.data.perlen >= resource.data.perlen
        && request.resource.data.perlen <= resource.data.perlen + 500;

      allow write: if istLehrer();
    }

    // ---------- Lernwoerter ----------
    // Alle angemeldeten Kinder duerfen lesen, aendern darfst nur du.
    match /lernwoerter/{id} {
      allow read:  if istLehrer() || istKlassenmitglied();
      allow write: if istLehrer();
    }

    // ---------- Fragen fuer den Sachunterricht ----------
    // Alle angemeldeten Kinder duerfen lesen, aendern darfst nur du.
    match /quizfragen/{id} {
      allow read:  if istLehrer() || istKlassenmitglied();
      allow write: if istLehrer();
    }

    // ---------- Einstellungen der Klasse ----------
    match /einstellungen/{id} {
      allow read:  if istLehrer() || istKlassenmitglied();
      allow write: if istLehrer();
    }

    // ---------- Zahlenschwarm: Stand eines Kindes ----------
    // Ein Dokument je Kind: zs_stand/<code>. Lernstand je Aufgabe,
    // Fischschwarm, Stempel, Lernzeit, Klasse. Kein Vorname.
    // Kein Kind kann den Stand eines anderen Kindes lesen.

    // Was die App schreibt (js/mische.js): nur diese Felder, mit
    // diesen Typen. Die Obergrenzen liegen ueber dem, was die App
    // hoechstens erzeugt (229 Aufgaben, 26 Stempel), damit ein
    // Kinderkonto das Dokument nicht beliebig aufblasen kann.
    function zsStandGueltig(d) {
      return d.keys().hasOnly(
               ['klasse', 'angelegt', 'aufgaben', 'schwarm', 'stempel', 'zeit', 'geaendert'])
        && d.keys().hasAll(
               ['klasse', 'aufgaben', 'schwarm', 'stempel', 'zeit', 'geaendert'])
        && d.klasse in [3, 4]
        && d.geaendert is number
        && d.geaendert >= 0
        && (!('angelegt' in d) || d.angelegt is number)
        && d.aufgaben is map && d.aufgaben.size() <= 400
        && d.schwarm is map && d.schwarm.size() <= 400
        && d.stempel is map && d.stempel.size() <= 60
        && d.zeit is map
        && d.zeit.keys().hasOnly(['mal', 'geteilt', 'plusminus', 'tag', 'heute'])
        && d.zeit.get('mal', 0) is number
        && d.zeit.get('geteilt', 0) is number
        && d.zeit.get('plusminus', 0) is number
        && d.zeit.get('tag', 0) is number
        && d.zeit.get('heute', 0) is number;
    }

    match /zs_stand/{code} {
      // get = das eigene Dokument gezielt holen.
      // list = alle durchblaettern (nur Lehrkraft, fuer Sicherung und Auskunft).
      allow get:    if istLehrer() || (istKind(code) && freigeschaltet(code));
      allow list:   if istLehrer();

      // Das Kind schreibt nur seinen eigenen Stand und nur in der
      // erlaubten Form. Die Lehrkraft darf schreiben, damit sie eine
      // Sicherung wieder einlesen kann.
      allow create, update: if istLehrer()
                            || (istKind(code) && freigeschaltet(code)
                                && zsStandGueltig(request.resource.data));

      allow delete: if istLehrer();
    }

    // ---------- Flaschenpost: Stand eines Kindes ----------
    // Ein Dokument je Kind: fp_stand/<code>. Fertige Briefe, Siegel,
    // Lernzeit je Modul, Selbsteinschaetzung. Kein Vorname, keine
    // eigenen Texte (die bleiben auf dem Geraet des Kindes).
    // Kein Kind kann den Stand eines anderen Kindes lesen.

    // Was die App schreibt (js/speicher.js, mische): genau diese Felder,
    // mit diesen Typen. Die Obergrenzen liegen weit ueber dem, was die
    // App heute hoechstens erzeugt (6 Briefe, 3 Module).
    function fpStandGueltig(d) {
      return d.keys().hasOnly(
               ['stationen', 'stempel', 'zeit', 'kannIch', 'angelegt', 'geaendert'])
        && d.keys().hasAll(
               ['stationen', 'stempel', 'zeit', 'kannIch', 'angelegt', 'geaendert'])
        && d.stationen is map && d.stationen.size() <= 60
        && d.stempel is map && d.stempel.size() <= 60
        && d.zeit is map && d.zeit.size() <= 20
        && d.kannIch is map && d.kannIch.size() <= 20
        && d.angelegt is int
        && d.geaendert is int;
    }

    match /fp_stand/{code} {
      // get = das eigene Dokument gezielt holen.
      // list = alle durchblaettern (nur Lehrkraft, fuer Sicherung und Auskunft).
      allow get:    if istLehrer() || (istKind(code) && freigeschaltet(code));
      allow list:   if istLehrer();

      // Das Kind schreibt nur seinen eigenen Stand und nur in der
      // erlaubten Form. Die Lehrkraft darf schreiben, damit sie eine
      // Sicherung wieder einlesen kann.
      allow create, update: if istLehrer()
                            || (istKind(code) && freigeschaltet(code)
                                && fpStandGueltig(request.resource.data));

      allow delete: if istLehrer();
    }

    // ---------- Riff-Akten: Stand eines Kindes ----------
    // Ein Dokument je Kind: ra_stand/<code>. Kein Vorname.
    // Kein Kind kann den Stand eines anderen Kindes lesen.

    // Was die App schreibt (Riff-Akten js/merge.js, mische): genau diese
    // Felder, mit diesen Typen. Ein Eintrag je Akte; 200 liegt weit ueber
    // dem, was es an Akten gibt (8). Neue Felder brauchen eine Regelaenderung.
    function raStandGueltig(d) {
      return d.keys().hasOnly(
               ['erledigt', 'stempel', 'zeit', 'eintraege', 'abzeichen', 'angelegt', 'geaendert'])
        && d.keys().hasAll(
               ['erledigt', 'stempel', 'zeit', 'eintraege', 'abzeichen', 'angelegt', 'geaendert'])
        && d.erledigt is map && d.erledigt.size() <= 200
        && d.stempel is map && d.stempel.size() <= 200
        && d.zeit is map && d.zeit.size() <= 200
        && d.eintraege is map && d.eintraege.size() <= 200
        && d.abzeichen is string && d.abzeichen.size() <= 20
        && d.angelegt is int
        && d.geaendert is int;
    }

    match /ra_stand/{code} {
      // get = das eigene Dokument gezielt holen.
      // list = alle durchblaettern (nur Lehrkraft, fuer Sicherung und Auswertung).
      allow get:    if istLehrer() || (istKind(code) && freigeschaltet(code));
      allow list:   if istLehrer();

      // Das Kind schreibt nur seinen eigenen Stand und nur in der
      // erlaubten Form. Die Lehrkraft darf schreiben, damit sie eine
      // Sicherung wieder einlesen kann.
      allow create, update: if istLehrer()
                            || (istKind(code) && freigeschaltet(code)
                                && raStandGueltig(request.resource.data));

      allow delete: if istLehrer();
    }

    // ---------- Riff-Akten: Akten und Loesungen ----------
    // Was die Kinder sehen (ra_faelle) und die Loesungen (ra_loesungen,
    // werden erst beim Pruefen geladen). Keine Kinderdaten. Lesen duerfen
    // die Lehrkraft und jedes freigeschaltete Kind, schreiben nur die
    // Lehrkraft (Lehrerbereich der Riff-Akten: "Akte hochladen").
    match /ra_faelle/{id} {
      allow read:  if istLehrer() || istKlassenmitglied();
      allow write: if istLehrer();
    }
    match /ra_loesungen/{id} {
      allow read:  if istLehrer() || istKlassenmitglied();
      allow write: if istLehrer();
    }

    // ---------- Alles Uebrige ist gesperrt ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
